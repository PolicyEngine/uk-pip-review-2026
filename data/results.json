  "data_limits": [
    {
      "key": "pip_daily_living_threshold_cut",
      "missing_input": "pip_points_of_people_turned_down",
      "reason": "The data hold assessment points only for people who get PIP. People turned down for daily living are not in the data, so a lower daily living standard threshold could only be costed for people who already get the mobility component, whose daily living points the data build drew below 8 (mostly 4 to 7). A cut to the standard threshold is not costed, alone or with other changes. A higher threshold, or an enhanced threshold lowered but kept at 8 or more, is costed on the assumption that the drawn points place recipients correctly within their award.",
      "issue": 3
    },
    {
      "key": "pip_mobility_threshold_cut",
      "missing_input": "pip_points_of_people_turned_down",
      "reason": "The data hold assessment points only for people who get PIP. People turned down for mobility are not in the data, and people who get only the daily living component hold mobility points of 0 or 4 drawn by the data build, so a mobility standard threshold of 5 to 7 moves no one (4 or lower moves only those drawn at 4). A cut to the standard threshold is not costed, alone or with other changes. A higher threshold, or an enhanced threshold lowered but kept at 8 or more, is costed on the assumption that the drawn points place recipients correctly within their award.",
      "issue": 3
    }
  ],
  "model_limits": [
    {
      "key": "pip_no_country_test",
      "reason": "The model counts Scottish Adult Disability Payment and Northern Ireland PIP as PIP. Figures cover England and Wales households only.",
      "issue": 1
    },
    {
      "key": "carers_allowance_ignores_pip",
      "reason": "Carer's Allowance in the model does not depend on the cared-for person's award, so a change to PIP awards leaves carers' payments unchanged.",
      "issue": 2
    },
    {
      "key": "uc_health_proxy",
      "reason": "The Universal Credit health element follows a recorded disability status, not PIP, so a change to PIP does not change it.",
      "issue": 6
    },
    {
      "key": "stored_disability_flags",
      "reason": "Recorded disability status does not follow a PIP change, so most disability premiums and elements in other benefits stay the same.",
      "issue": 7
    },
    {
      "key": "caseload_grows_with_population",
      "reason": "The PIP caseload is calibrated to the OBR's PIP forecast for 2025-26, which is close to DWP's figures. In later years it grows with the population, not with DWP's caseload forecast, so it falls further below DWP's forecast in each later year.",
      "issue": 4
    }
